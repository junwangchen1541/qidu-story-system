{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/qidu-story-system/route.schema.json",
  "title": "剧情路线数据",
  "type": "object",
  "required": ["meta", "initial", "locations", "events", "messages", "endings"],
  "properties": {
    "meta": {
      "type": "object", "required": ["id", "title", "revision"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string" }, "revision": { "type": "string", "minLength": 1 } }
    },
    "initial": {
      "type": "object",
      "required": ["flags", "vars"],
      "properties": {
        "flags": { "type": "array", "items": { "type": "string" } },
        "vars": { "type": "object" }
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "x", "y"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "desc": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "location", "conditions", "lines", "choices"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "location": { "type": "string" },
          "label": { "type": "string" },
          "bg": { "type": "string" },
          "conditions": { "type": "array" },
          "cast": { "type": "object" },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["text"],
              "properties": {
                "speaker": { "type": "string" },
                "text": { "type": "string" },
                "screen": { "type": "string", "enum": ["black_title"] },
                "effect": { "type": "string", "enum": ["shake", "white_flash"] }
              }
            }
          },
          "choices": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["text", "effects"], "properties": { "text": { "type": "string" }, "effects": { "type": "array" } } } }
        }
      }
    },
    "messages": { "type": "array", "items": { "type": "object", "required": ["id", "title", "from", "text", "readFlag", "unlock"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "from": { "type": "string" }, "text": { "type": "string" }, "readFlag": { "type": "string" }, "unlock": { "type": "array" } } } },
    "endings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "conditions", "text"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "conditions": { "type": "array" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
